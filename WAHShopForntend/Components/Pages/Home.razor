@page "/"
@namespace WAHShopForntend.Components.Layout
@inject IStringLocalizer<WAHShopForntend.Components.Layout.Home> L

@* Description Cards *@
<div class="FeatureSectionContainer">
	@if (!IsRendered.Initialized || !IsRendered.ParametersSet || !IsRendered.AfterRender || !IsImageLoaded)
	{
		<WAHShopForntend.Components.Layout.Loading />
	}

	<div class="@(IsImageLoaded ? "" : "invisible-hero")">
		@* Hero Section *@
		<WAHShopForntend.Components.Layout.HeroSection OnImageLoadedCallback="HandleImageLoaded" />

		@foreach (var item in FeatureSections)
		{
			<WAHShopForntend.Components.Layout.FeatureSection model="item" />
		}
	</div>
</div>

