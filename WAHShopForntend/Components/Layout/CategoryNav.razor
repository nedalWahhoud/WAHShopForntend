@implements IDisposable
@inject IStringLocalizer<WAHShopForntend.Components.Layout.CategoryNav> L
@inherits ProjectComponentBase
<div class="categoryNav">
    @if (!string.IsNullOrEmpty(activeDropdownId))
    {
        <div class="backdrop" @onclick='() => ToggleDropdown(null!)'></div>
    }
    @* foodstuffs *@
    <div class="dropdown @(activeDropdownId == "foodstuffs" ? "active" : "")">
        <button class="dropdownButton" @onclick='() => ToggleDropdown("foodstuffs")'>▼ @L["foodstuffs"]</button>
        <div class="dropdownMenu">
            @if (categoryService.DownloadedCategories == null || categoryService.DownloadedCategories.Count == 0)
            {
                @SkeletonRows
            }
            else
            {
                var foodstuffsArray = GetFoodstuffs();
                if (foodstuffsArray != null)
                {
                    for (int i = 0; i < foodstuffsArray.Count; i += 5)
                    {
                        <ul class="column">
                            @for (int j = i; j < i + 5 && j < foodstuffsArray.Count; j++)
                            {
                                var category = foodstuffsArray[j];

                                <li @onclick="() => OnCategory(category)"
                                    class="categoryLink @(category.Id == currentCategoryId ? "selected" : "")">
                                    @(IsArabic ? category.Name_ar : category.Name_de)
                                </li>
                            }
                        </ul>
                    }

                }
            }
        </div>
    </div>
    @* drinks *@
    <div class="dropdown @(activeDropdownId == "drinks" ? "active" : "")">
        <button class="dropdownButton" @onclick='() => ToggleDropdown("drinks")'>▼ @L["drinks"]</button>
        <div class="dropdownMenu">
            @if (categoryService.DownloadedCategories == null || categoryService.DownloadedCategories.Count == 0)
            {
                @SkeletonRows
            }
            else
            {
                var drinksArray = GetDrinks();
                if (drinksArray != null)
                {
                    for (int i = 0; i < drinksArray.Count; i += 5)
                    {
                        <ul class="column">
                            @for (int j = i; j < i + 5 && j < drinksArray.Count; j++)
                            {
                                var category = drinksArray[j];
                                <li @onclick="() => OnCategory(category)"
                                    class="categoryLink @(category.Id == currentCategoryId ? "selected" : "")">
                                    @(IsArabic ? category.Name_ar : category.Name_de)
                                </li>
                            }
                        </ul>
                    }

                }
            }
        </div>
    </div>
    @* SweetsSnacks *@
    <div class="dropdown @(activeDropdownId == "sweetsSnacks" ? "active" : "")">
        <button class="dropdownButton" @onclick='() => ToggleDropdown("sweetsSnacks")'>▼ @L["SweetsSnacks"]</button>
        <div class="dropdownMenu">
            @if (categoryService.DownloadedCategories == null || categoryService.DownloadedCategories.Count == 0)
            {
                @SkeletonRows
            }
            else
            {
                var SweetsSnacksArray = GetSweetsSnacks();
                if (SweetsSnacksArray != null)
                {
                    for (int i = 0; i < SweetsSnacksArray.Count; i += 5)
                    {
                        <ul class="column">
                            @for (int j = i; j < i + 5 && j < SweetsSnacksArray.Count; j++)
                            {
                                var category = SweetsSnacksArray[j];
                                <li @onclick="() => OnCategory(category)"
                                    class="categoryLink @(category.Id == currentCategoryId ? "selected" : "")">
                                    @(IsArabic ? category.Name_ar : category.Name_de)
                                </li>
                            }
                        </ul>
                    }
                }
            }
        </div>
    </div>
    @* Fleische *@
    <div class="dropdown @(activeDropdownId == "meats" ? "active" : "")">
        <button class="dropdownButton" @onclick='() => ToggleDropdown("meats")'>▼ @L["Meats"]</button>
        <div class="dropdownMenu">
            @if (categoryService.DownloadedCategories == null || categoryService.DownloadedCategories.Count == 0)
            {
                @SkeletonRows
            }
            else
            {
                var Mates = GetMeats();
                if (Mates != null)
                {
                    for (int i = 0; i < Mates.Count; i += 5)
                    {
                        <ul class="column">
                            @for (int j = i; j < i + 5 && j < Mates.Count; j++)
                            {
                                var category = Mates[j];
                                <li @onclick="() => OnCategory(category)"
                                    class="categoryLink @(category.Id == currentCategoryId ? "selected" : "")">
                                    @(IsArabic ? category.Name_ar : category.Name_de)
                                </li>
                            }
                        </ul>
                    }
                }
            }
        </div>
    </div>
    @* ohne dropdown *@
    @{
        @* Household *@
        var householdCategory = GetHousehold();
        if (categoryService.DownloadedCategories == null || categoryService.DownloadedCategories.Count == 0)
        {
            @InlineSkeleton(L["Household"])
        }
        else if (householdCategory != null)
        {
            <a @onclick="() => OnCategory(householdCategory)"
               class="categoryLink @(householdCategory.Id == currentCategoryId ? "selected" : "")">
                @(IsArabic ? householdCategory.Name_ar : householdCategory.Name_de)
            </a>
        }
        @* Dates *@
        var DatesCategory = GetDates();
        if (categoryService.DownloadedCategories == null || categoryService.DownloadedCategories.Count == 0)
        {
            @InlineSkeleton(L["Dates"])
        }
        else if(DatesCategory != null)
        {
            <a @onclick="() => OnCategory(DatesCategory)"
               class="categoryLink @(DatesCategory.Id == currentCategoryId ? "selected" : "")">
                @(IsArabic ? DatesCategory.Name_ar : DatesCategory.Name_de)
            </a>
        }
        @* Other *@
        var otherCategory = GetOther();
        if (categoryService.DownloadedCategories == null || categoryService.DownloadedCategories.Count == 0)
        {
            @InlineSkeleton(L["Other"])
        }
        else if(otherCategory != null)
        {
            <a @onclick="() => OnCategory(otherCategory)"
               class="categoryLink @(otherCategory.Id == currentCategoryId ? "selected" : "")">
                @(IsArabic ? otherCategory.Name_ar : otherCategory.Name_de)
            </a>
        }
    }
    @* Im Angebot *@
    <a @onclick='() => OnCategory(new() { Id = -1, Name_ar = "العروض" ,Name_de="Im Angebot"})'
       class="categoryLinkOnOffer @(currentCategoryId == -1 ? "selected" : "")">
        @L["OnOffer"]
    </a>
</div>
@code {
    private RenderFragment SkeletonRows => @<ul class="column skeleton-loading-wrapper">
    <li><div class="skeleton-text" style="width: 110px;"></div></li>
    <li><div class="skeleton-text" style="width: 85px;"></div></li>
    <li><div class="skeleton-text" style="width: 100px;"></div></li>
    <li><div class="skeleton-text" style="width: 70px;"></div></li>
    </ul>;
    private RenderFragment<string> InlineSkeleton => text => @<text>
        <a class="categoryLink" style="pointer-events: none; cursor: default; display: inline-block;">
            @* Blinken wenn die data noch nicht da *@
            <span class="skeleton-text" style="width: 110px; color: transparent !important; display: inline-block;">
                @text
            </span>
        </a>
    </text>;
    private int currentCategoryId = 0;
    protected override async Task OnInitializedAsync()
    {
		// wenn die Kategorien noch nicht geladen sind, warten bis sie geladen sind, die await ist klug genug, um weißen ob schon geladen sind oder nicht, daher bruchen kein if
        await categoryService.taskCatyrories;

        navigationManager.LocationChanged += HandleLocationChanged;
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // get die Höhe der header
            await JS.InvokeVoidAsync("getElementHeight", ".categoryNav", "--categoryNav-height");
        }
    }
    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
		// Extrahiere die Kategorie-ID aus der URL und aktualisiere currentCategoryId entsprechend
        var uri = new Uri(navigationManager.Uri);
        var segments = uri.Segments;

        if (segments.Length > 2 && segments[1].TrimEnd('/') == "ProductsByCategory")
        {
            var rawId = segments[2].Trim('/');
            rawId = new string(rawId.Where(ch => char.IsDigit(ch) || ch == '-').ToArray());

            if (!int.TryParse(rawId, out var id))
                currentCategoryId = 0;
            else
                currentCategoryId = id;
        }
        else
        {
            currentCategoryId = 0;
        }
        StateHasChanged(); 
    }
  
    private void OnCategory(Categories category)
    {
        var categoryName = IsArabic ? category.Name_ar : category.Name_de;
        var slug = GenerateSlug(categoryName!);

        navigationManager.NavigateTo($"/ProductsByCategory/{slug}/{category.Id}");
    }
    // 
    private List<Categories> GetFoodstuffs()
    {
        return categoryService.DownloadedCategories?
                    .Where(c =>
                    (c.Id >= 9 && c.Id <= 13) ||
                    (c.Id >= 15 && c.Id <= 19) ||
                    (c.Id == 21) ||
                    (c.Id >= 24 && c.Id <= 29) || 
                    (c.Id == 38))
                    .ToList() ?? null!;
    }
    private List<Categories> GetDrinks()
    {
        return categoryService.DownloadedCategories?
                    .Where(c =>
                    (c.Id >= 6 && c.Id <= 7) ||
                    (c.Id == 14) ||
                    (c.Id == 23))
                    .ToList() ?? null!;
    }
    private List<Categories> GetSweetsSnacks()
    {
        return categoryService.DownloadedCategories?
                    .Where(c =>
                    (c.Id == 8) ||
                    (c.Id >= 30 && c.Id <= 31) ||
                    (c.Id == 33) || 
                    (c.Id == 39))
                    .ToList() ?? null!;
    }
	private List<Categories> GetMeats()
	{
        var ids = new List<int> { 34, 35, 36 };
		return categoryService.DownloadedCategories?
					.Where(c => ids.Contains(c.Id))
					.ToList() ?? null!;
	}
    private Categories GetOther()
    {
        return categoryService.DownloadedCategories?
                    .FirstOrDefault(c => c.Id == 32) ?? null!;
    }
    private Categories GetHousehold()
	{
		return categoryService.DownloadedCategories?
					.FirstOrDefault(c => c.Id == 40) ?? null!;
	}
    private Categories GetDates()
    {
        return categoryService.DownloadedCategories?
                    .FirstOrDefault(c => c.Id == 41) ?? null!;
    }

    /**/
    private string? activeDropdownId = null;
    private void ToggleDropdown(string id)
    {
       activeDropdownId = (activeDropdownId == id) ? null : id;
    }
    public void Dispose()
    {
        navigationManager.LocationChanged -= HandleLocationChanged;
    }
}
